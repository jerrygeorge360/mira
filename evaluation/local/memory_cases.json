{
  "name": "MIRA local memory evaluation suite",
  "cases": [
    {
      "id": "fact-recall-deadline",
      "category": "direct_fact_recall",
      "interactions": [
        {
          "message": "My project deadline is Friday."
        },
        {
          "message": "What is my deadline?"
        }
      ],
      "expect": {
        "retrieval_mode": "quick",
        "answer_contains": [
          "Friday"
        ]
      }
    },
    {
      "id": "session-correction-year",
      "category": "session_correction_handling",
      "interactions": [
        {
          "message": "Use 2026, not 2025, for all dates."
        }
      ],
      "expect": {
        "used_session_items_nonempty": true,
        "active_session_item_labels_include": [
          "type:correction",
          "explicitness_label:direct_correction"
        ]
      }
    },
    {
      "id": "cross-session-continue",
      "category": "cross_session_recall",
      "interactions": [
        {
          "message": "We must keep MIRA session memory separate from durable tiers."
        },
        {
          "message": "Continue from where we stopped on MIRA memory.",
          "reset_session": true
        }
      ],
      "expect": {
        "answer_contains": [
          "MIRA"
        ],
        "answer_excludes": [
          "deadline",
          "Friday"
        ]
      }
    },
    {
      "id": "contradiction-preferences",
      "category": "contradiction_handling",
      "interactions": [
        {
          "message": "I prefer Python."
        },
        {
          "message": "Actually I prefer Rust."
        },
        {
          "message": "What do I prefer?"
        }
      ],
      "expect": {
        "answer_contains": [
          "Rust"
        ],
        "slow_path_created_edge_types_include": [
          "SUPERSEDED_BY"
        ]
      }
    },
    {
      "id": "supersession-migration",
      "category": "supersession_handling",
      "interactions": [
        {
          "message": "I switched from MongoDB to PostgreSQL for storage."
        },
        {
          "message": "What database do I use now?"
        }
      ],
      "expect": {
        "retrieval_mode": "relational",
        "min_retrieved_records": 1,
        "retrieved_sources_include": [
          "graph_edge"
        ],
        "answer_contains": [
          "PostgreSQL"
        ]
      }
    },
    {
      "id": "foresight-hackathon",
      "category": "foresight_activation",
      "interactions": [
        {
          "message": "The hackathon submission is due next Friday."
        },
        {
          "message": "Anything time-sensitive I should remember?"
        }
      ],
      "expect": {
        "answer_contains": [
          "hackathon"
        ],
        "retrieved_sources_include": [
          "foresight_records"
        ]
      }
    },
    {
      "id": "deep-developer-identity",
      "category": "deep_mode_synthesis",
      "interactions": [
        {
          "message": "I am a developer building MIRA memory infrastructure with PostgreSQL-backed storage."
        },
        {
          "message": "I prefer Rust for systems work and Python for tooling."
        },
        {
          "message": "What kind of developer am I?"
        }
      ],
      "expect": {
        "retrieval_mode": "deep",
        "answer_contains": [
          "PostgreSQL"
        ],
        "min_retrieved_records": 1
      }
    },
    {
      "id": "sufficiency-unknown-entity",
      "category": "retrieval_sufficiency",
      "interactions": [
        {
          "message": "What did I decide about Kubernetes?"
        }
      ],
      "expect": {
        "answer_contains": [
          "Kubernetes"
        ]
      }
    },
    {
      "id": "general-knowledge-no-memory",
      "category": "routing_intent",
      "interactions": [
        {
          "message": "What is an apple?"
        }
      ],
      "expect": {
        "retrieval_mode": "general",
        "intent": "general_knowledge",
        "used_memory": false,
        "route": "direct_llm"
      }
    },
    {
      "id": "personal-memory-uses-memory",
      "category": "routing_intent",
      "interactions": [
        {
          "message": "My favorite fruit is orange."
        },
        {
          "message": "What is my favorite fruit?"
        }
      ],
      "expect": {
        "retrieval_mode": "quick",
        "intent": "personal_memory",
        "used_memory": true
      }
    }
  ]
}
