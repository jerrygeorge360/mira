DASHSCOPE_API_KEY=your_dashscope_api_key_here
# Full chat-completions URL (MIRA POSTs to this verbatim; must include /chat/completions).
# Pick the region your API key is provisioned for:
#   international:   https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
#   mainland China:  https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_CHAT_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
MIRA_DB_PATH=./mira.db
CHROMA_DB_PATH=./chroma_db
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_APP_TOKEN=your_slack_app_token_here
MIRA_SESSION_TTL_MINUTES=120
MIRA_PROMPT_TOKEN_BUDGET=32000
