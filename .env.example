# Provider profile presets. Set one value and the adapter fills the default
# endpoint/model/provider. Explicit LLM_* values below still override the preset.
# Supported: dashscope, siliconflow, deepseek, gemini
LLM_PROFILE=dashscope

# Provider-specific keys used by LLM_PROFILE. You may also set LLM_API_KEY as a
# generic override if you prefer one variable.
DASHSCOPE_API_KEY=
SILICONFLOW_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
# LLM_API_KEY=

# Optional chat overrides. Leave empty to use the selected LLM_PROFILE.
# LLM_CHAT_ENDPOINT=
# LLM_MODEL=
# LLM_PROVIDER=
# auto uses json_schema when supported and json_object for DeepSeek.
# Set to json_schema for providers with strict schema support, or json_object for JSON mode only.
LLM_RESPONSE_FORMAT=auto
# Max tokens for structured JSON calls. Keep this high enough to avoid truncated JSON.
LLM_JSON_MAX_TOKENS=2048
# Optional context-compression gateway. Leave disabled for an uncompressed baseline.
MIRA_PARITOK_ENABLED=false
PARITOK_API_KEY=
# Local host URL. Docker Compose overrides this to http://paritok:8080.
PARITOK_BASE_URL=http://127.0.0.1:8081/v1
# The proxy forwards compressed requests to the selected provider endpoint.
PARITOK_UPSTREAM_ENDPOINT=https://api.deepseek.com/chat/completions
# Must match LLM_PROFILE while the Paritok gateway is active. Restart the
# Paritok service after changing its upstream provider.
PARITOK_UPSTREAM_PROFILE=deepseek
# Optional current provider prices used only for MIRA's displayed USD estimate.
# Token counts remain available without prices.
# MIRA_LLM_INPUT_COST_PER_MILLION_USD=
# MIRA_LLM_OUTPUT_COST_PER_MILLION_USD=
# OpenAI-compatible embeddings. If EMBEDDING_API_KEY is omitted, LLM_API_KEY is reused.
# The endpoint may include /embeddings; otherwise the OpenAI client treats it as the API base URL.
# EMBEDDING_API_KEY=
# EMBEDDING_ENDPOINT=
# EMBEDDING_MODEL=
# Optional. Supported by providers/models such as SiliconFlow Qwen embeddings.
# EMBEDDING_DIMENSIONS=
# auto calls the embedding API when credentials exist; deterministic forces local hash vectors.
EMBEDDING_MODE=auto
# For local CPU embeddings, use:
#   EMBEDDING_MODE=local
#   LOCAL_EMBEDDING_PROVIDER=fastembed
#   LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_PROVIDER=fastembed
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_CACHE_DIR=
# deterministic keeps tests/offline dev working; use error in production if embeddings must be real.
EMBEDDING_FALLBACK=deterministic
# Legacy DashScope endpoint is still supported as a fallback.
DASHSCOPE_CHAT_ENDPOINT=
MIRA_DB_PATH=./mira.db
CHROMA_DB_PATH=./chroma_db
# Sensa uses this IANA timezone to resolve relative dates such as "tomorrow".
MIRA_USER_TIMEZONE=UTC
# Authentication is explicit: development binds requests to the local legacy
# workspace; github uses server-side sessions and a GitHub OAuth app.
MIRA_AUTH_MODE=development
# Comma-separated GitHub logins allowed to open the read-only platform dashboard.
# Workspace owner/admin roles do not grant this access. Empty means nobody.
MIRA_ADMIN_GITHUB_LOGINS=
# MIRA_DEVELOPMENT_WORKSPACE_ID=workspace_legacy_default
# Explicit bindings for non-browser integrations and inspection commands.
MIRA_WORKSPACE_ID=workspace_legacy_default
MIRA_STREAMLIT_WORKSPACE_ID=workspace_legacy_default
MIRA_MCP_WORKSPACE_ID=workspace_legacy_default
# Standalone MCP service auth. Generate a long random value before exposing it.
# MIRA_MCP_API_KEY=
# For multiple clients/workspaces, use a JSON object: {"token":"workspace_id"}.
# MIRA_MCP_TOKEN_WORKSPACES=
# Public origin of the standalone MCP service (the protocol endpoint is /mcp).
MIRA_MCP_PUBLIC_URL=http://localhost:8090
# OAuth authorization server. Production should use the public HTTPS origin.
MIRA_OAUTH_ISSUER_URL=http://localhost:8000
# Pre-register trusted public clients. Redirect URIs must be HTTPS or HTTP loopback URLs.
MIRA_OAUTH_FIRST_PARTY_CLIENTS=[]
# Example:
# MIRA_OAUTH_FIRST_PARTY_CLIENTS=[{"client_id":"mira-desktop","client_name":"MIRA Desktop","redirect_uris":["http://127.0.0.1:43110/callback"]}]
MIRA_OAUTH_ACCESS_TOKEN_TTL_SECONDS=900
MIRA_OAUTH_REFRESH_TOKEN_TTL_DAYS=30
# Legacy issuer variable remains accepted for existing deployments.
# MIRA_MCP_ISSUER_URL=
# JSON object mapping immutable Slack team IDs to MIRA workspace IDs.
MIRA_SLACK_TEAM_WORKSPACES={"T01234567":"workspace_legacy_default"}
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_CALLBACK_URL=http://localhost:8000/auth/github/callback
APP_BASE_URL=http://localhost:5173
# Set true behind HTTPS. Local HTTP development requires false.
COOKIE_SECURE=false
# Disposable demo controls. Each visitor receives a separate expiring workspace.
MIRA_DEMO_TTL_MINUTES=60
MIRA_DEMO_MAX_ACTIVE=10
MIRA_DEMO_MAX_PER_WINDOW=3
MIRA_DEMO_ISSUANCE_WINDOW_MINUTES=60
# Lightweight in-process API limits for the local/Docker product server.
MIRA_RATE_LIMIT_ENABLED=true
MIRA_RATE_LIMIT_REQUESTS=120
MIRA_CHAT_RATE_LIMIT_REQUESTS=30
MIRA_RATE_LIMIT_WINDOW_S=60
# Docker Compose defaults mount persistent data here:
#   MIRA_DB_PATH=/data/sqlite/mira.db
#   CHROMA_DB_PATH=/data/chroma
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_APP_TOKEN=your_slack_app_token_here
MIRA_SESSION_TTL_MINUTES=120
MIRA_PROMPT_TOKEN_BUDGET=32000
