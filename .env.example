# OpenAI-compatible chat provider. MIRA POSTs to LLM_CHAT_ENDPOINT verbatim,
# so the URL must include /chat/completions.
# Examples:
#   DashScope intl:  https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
#   DashScope China: https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
#   DeepSeek:        https://api.deepseek.com/chat/completions
#   SiliconFlow:     https://api.siliconflow.com/v1/chat/completions
#   Gemini:          https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
LLM_API_KEY=your_provider_api_key_here
LLM_CHAT_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions
LLM_MODEL=qwen-plus
LLM_PROVIDER=dashscope
# auto uses json_schema when supported and json_object for DeepSeek/SiliconFlow.
# Set to json_schema for providers with strict schema support, or json_object for JSON mode only.
LLM_RESPONSE_FORMAT=auto
# OpenAI-compatible embeddings. If EMBEDDING_API_KEY is omitted, LLM_API_KEY is reused.
# The endpoint may include /embeddings; otherwise the OpenAI client treats it as the API base URL.
EMBEDDING_API_KEY=
EMBEDDING_ENDPOINT=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/embeddings
EMBEDDING_MODEL=text-embedding-v4
# Optional. Supported by providers/models such as SiliconFlow Qwen embeddings.
EMBEDDING_DIMENSIONS=
# auto calls the embedding API when credentials exist; deterministic forces local hash vectors.
EMBEDDING_MODE=auto
# For local CPU embeddings, use:
#   EMBEDDING_MODE=local
#   LOCAL_EMBEDDING_PROVIDER=fastembed
#   LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
LOCAL_EMBEDDING_PROVIDER=fastembed
LOCAL_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# deterministic keeps tests/offline dev working; use error in production if embeddings must be real.
EMBEDDING_FALLBACK=deterministic
# Legacy DashScope variables are still supported as fallbacks.
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_ENDPOINT=
MIRA_DB_PATH=./mira.db
CHROMA_DB_PATH=./chroma_db
# Docker Compose defaults mount persistent data here:
#   MIRA_DB_PATH=/data/sqlite/mira.db
#   CHROMA_DB_PATH=/data/chroma
SLACK_BOT_TOKEN=your_slack_bot_token_here
SLACK_APP_TOKEN=your_slack_app_token_here
MIRA_SESSION_TTL_MINUTES=120
MIRA_PROMPT_TOKEN_BUDGET=32000
